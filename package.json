{
  "name": "naira-desk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "agent:new-key": "node scripts/new-agent-key.ts",
    "agent:register": "node scripts/register-agent.ts",
    "agent:update-card": "node scripts/update-agent-card.ts",
    "buy:search": "node scripts/buy-search.ts",
    "risk:check": "node scripts/risk-check.ts",
    "vault:deploy": "node scripts/deploy-vault.ts",
    "vault:status": "node scripts/vault-status.ts",
    "vault:set-signer": "node scripts/vault-signer.ts",
    "taker:deploy": "forge build --root packages/contracts && node scripts/deploy-taker.ts",
    "taker:verify": "forge build --root packages/contracts && node scripts/verify-taker.ts",
    "price": "node scripts/price.ts",
    "agent": "node apps/agent/src/main.ts",
    "agent:review": "node apps/agent/src/review-now.ts",
    "taker:take": "node apps/agent/src/take-now.ts",
    "indexer": "node apps/indexer/src/main.ts",
    "web": "pnpm --filter @naira-desk/web dev"
  },
  "dependencies": {
    "@naira-desk/chain": "workspace:*",
    "@naira-desk/intel": "workspace:*",
    "@naira-desk/pricing": "workspace:*",
    "@naira-desk/shared": "workspace:*",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
