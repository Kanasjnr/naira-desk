{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "performance": {
        "noNamespaceImport": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "viem": {
                "importNames": [
                  "createWalletClient",
                  "walletActions",
                  "createTestClient",
                  "testActions"
                ],
                "message": "Use createTaggedWalletClient from @naira-desk/chain."
              },
              "viem/accounts": {
                "importNames": [
                  "privateKeyToAccount",
                  "mnemonicToAccount",
                  "hdKeyToAccount",
                  "toAccount",
                  "signTransaction",
                  "sign"
                ],
                "message": "Use createTaggedWalletClient from @naira-desk/chain."
              },
              "viem/actions": {
                "importNames": [
                  "sendTransaction",
                  "sendTransactionSync",
                  "sendRawTransaction",
                  "sendRawTransactionSync",
                  "writeContract",
                  "writeContractSync",
                  "deployContract",
                  "sendCalls",
                  "sendCallsSync",
                  "signTransaction"
                ],
                "message": "Send through createTaggedWalletClient from @naira-desk/chain."
              }
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/chain/src/wallet.ts", "packages/chain/src/wallet.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
